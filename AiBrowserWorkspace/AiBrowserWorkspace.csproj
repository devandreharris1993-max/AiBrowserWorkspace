<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiBrowserWorkspace</RootNamespace>
    <AssemblyName>AiBrowserWorkspace</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- CEF resolves locales/ relative to libcef.dll (the app output dir), but
       WebViewControl only copies them under CefGlueBrowserProcess/. Without
       this copy, the first navigation can sit on a blank "Loading…" page. -->
  <Target Name="CopyCefLocales" AfterTargets="Build">
    <ItemGroup>
      <CefLocaleFiles Include="$(OutputPath)CefGlueBrowserProcess\locales\*.pak" />
    </ItemGroup>
    <Copy SourceFiles="@(CefLocaleFiles)" DestinationFolder="$(OutputPath)locales" SkipUnchangedFiles="true" />
    <Exec Condition="Exists('$(OutputPath)CefGlueBrowserProcess\Xilium.CefGlue.BrowserProcess.exe')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\tools\EmbedWinManifest.ps1&quot; -ExePath &quot;$(OutputPath)CefGlueBrowserProcess\Xilium.CefGlue.BrowserProcess.exe&quot; -ManifestPath &quot;$(MSBuildThisFileDirectory)app.manifest&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.10" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="WebViewControl-Avalonia" Version="3.120.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Styles/**" />
  </ItemGroup>

</Project>
